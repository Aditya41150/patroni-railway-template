# Patroni Railway Template - .gitignore

# Docker
docker-compose.override.yml
.dockerignore

# Environment files
.env
.env.local
.env.*.local

# Logs
*.log
logs/

# Database dumps
*.sql
*.dump
*.backup

# Temporary files
*.tmp
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.sublime-*

# Testing
test-results/
coverage/

# Build artifacts
dist/
build/

# Node modules (if adding any tooling)
node_modules/

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
*.so
.pytest_cache/

# Volumes (local testing)
volumes/
data/
