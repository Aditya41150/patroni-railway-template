{
    "name": "Patroni PostgreSQL High Availability",
    "description": "Production-ready PostgreSQL cluster with automatic failover, streaming replication, and load balancing using Patroni, etcd, and HAProxy",
    "icon": "https://raw.githubusercontent.com/zalando/patroni/master/docs/patroni.png",
    "tags": [
        "postgresql",
        "database",
        "high-availability",
        "patroni",
        "etcd",
        "haproxy"
    ],
    "services": [
        {
            "name": "etcd1",
            "source": {
                "directory": "etcd"
            },
            "env": {
                "ETCD_NODE_NUM": "1",
                "ETCD1_PRIVATE_DOMAIN": "${{etcd1.RAILWAY_PRIVATE_DOMAIN}}",
                "ETCD2_PRIVATE_DOMAIN": "${{etcd2.RAILWAY_PRIVATE_DOMAIN}}",
                "ETCD3_PRIVATE_DOMAIN": "${{etcd3.RAILWAY_PRIVATE_DOMAIN}}"
            },
            "volumes": [
                {
                    "mountPath": "/etcd-data"
                }
            ],
            "healthcheck": {
                "path": "/health",
                "port": 2379
            }
        },
        {
            "name": "etcd2",
            "source": {
                "directory": "etcd"
            },
            "env": {
                "ETCD_NODE_NUM": "2",
                "ETCD1_PRIVATE_DOMAIN": "${{etcd1.RAILWAY_PRIVATE_DOMAIN}}",
                "ETCD2_PRIVATE_DOMAIN": "${{etcd2.RAILWAY_PRIVATE_DOMAIN}}",
                "ETCD3_PRIVATE_DOMAIN": "${{etcd3.RAILWAY_PRIVATE_DOMAIN}}"
            },
            "volumes": [
                {
                    "mountPath": "/etcd-data"
                }
            ],
            "healthcheck": {
                "path": "/health",
                "port": 2379
            }
        },
        {
            "name": "etcd3",
            "source": {
                "directory": "etcd"
            },
            "env": {
                "ETCD_NODE_NUM": "3",
                "ETCD1_PRIVATE_DOMAIN": "${{etcd1.RAILWAY_PRIVATE_DOMAIN}}",
                "ETCD2_PRIVATE_DOMAIN": "${{etcd2.RAILWAY_PRIVATE_DOMAIN}}",
                "ETCD3_PRIVATE_DOMAIN": "${{etcd3.RAILWAY_PRIVATE_DOMAIN}}"
            },
            "volumes": [
                {
                    "mountPath": "/etcd-data"
                }
            ],
            "healthcheck": {
                "path": "/health",
                "port": 2379
            }
        },
        {
            "name": "patroni1",
            "source": {
                "directory": "patroni"
            },
            "env": {
                "PATRONI_SCOPE": "railway-patroni",
                "PATRONI_NAME": "patroni1",
                "PATRONI_PRIVATE_DOMAIN": "${{patroni1.RAILWAY_PRIVATE_DOMAIN}}",
                "ETCD1_PRIVATE_DOMAIN": "${{etcd1.RAILWAY_PRIVATE_DOMAIN}}",
                "ETCD2_PRIVATE_DOMAIN": "${{etcd2.RAILWAY_PRIVATE_DOMAIN}}",
                "ETCD3_PRIVATE_DOMAIN": "${{etcd3.RAILWAY_PRIVATE_DOMAIN}}",
                "POSTGRES_PASSWORD": "${{shared.POSTGRES_PASSWORD}}",
                "REPLICATION_PASSWORD": "${{shared.REPLICATION_PASSWORD}}"
            },
            "volumes": [
                {
                    "mountPath": "/var/lib/postgresql/data"
                }
            ],
            "healthcheck": {
                "path": "/health",
                "port": 8008
            }
        },
        {
            "name": "patroni2",
            "source": {
                "directory": "patroni"
            },
            "env": {
                "PATRONI_SCOPE": "railway-patroni",
                "PATRONI_NAME": "patroni2",
                "PATRONI_PRIVATE_DOMAIN": "${{patroni2.RAILWAY_PRIVATE_DOMAIN}}",
                "ETCD1_PRIVATE_DOMAIN": "${{etcd1.RAILWAY_PRIVATE_DOMAIN}}",
                "ETCD2_PRIVATE_DOMAIN": "${{etcd2.RAILWAY_PRIVATE_DOMAIN}}",
                "ETCD3_PRIVATE_DOMAIN": "${{etcd3.RAILWAY_PRIVATE_DOMAIN}}",
                "POSTGRES_PASSWORD": "${{shared.POSTGRES_PASSWORD}}",
                "REPLICATION_PASSWORD": "${{shared.REPLICATION_PASSWORD}}"
            },
            "volumes": [
                {
                    "mountPath": "/var/lib/postgresql/data"
                }
            ],
            "healthcheck": {
                "path": "/health",
                "port": 8008
            }
        },
        {
            "name": "patroni3",
            "source": {
                "directory": "patroni"
            },
            "env": {
                "PATRONI_SCOPE": "railway-patroni",
                "PATRONI_NAME": "patroni3",
                "PATRONI_PRIVATE_DOMAIN": "${{patroni3.RAILWAY_PRIVATE_DOMAIN}}",
                "ETCD1_PRIVATE_DOMAIN": "${{etcd1.RAILWAY_PRIVATE_DOMAIN}}",
                "ETCD2_PRIVATE_DOMAIN": "${{etcd2.RAILWAY_PRIVATE_DOMAIN}}",
                "ETCD3_PRIVATE_DOMAIN": "${{etcd3.RAILWAY_PRIVATE_DOMAIN}}",
                "POSTGRES_PASSWORD": "${{shared.POSTGRES_PASSWORD}}",
                "REPLICATION_PASSWORD": "${{shared.REPLICATION_PASSWORD}}"
            },
            "volumes": [
                {
                    "mountPath": "/var/lib/postgresql/data"
                }
            ],
            "healthcheck": {
                "path": "/health",
                "port": 8008
            }
        },
        {
            "name": "haproxy",
            "source": {
                "directory": "haproxy"
            },
            "env": {
                "PATRONI1_PRIVATE_DOMAIN": "${{patroni1.RAILWAY_PRIVATE_DOMAIN}}",
                "PATRONI2_PRIVATE_DOMAIN": "${{patroni2.RAILWAY_PRIVATE_DOMAIN}}",
                "PATRONI3_PRIVATE_DOMAIN": "${{patroni3.RAILWAY_PRIVATE_DOMAIN}}",
                "HAPROXY_STATS_USER": "admin",
                "HAPROXY_STATS_PASSWORD": "${{shared.HAPROXY_STATS_PASSWORD}}"
            },
            "healthcheck": {
                "path": "/health",
                "port": 8008
            }
        }
    ],
    "sharedVariables": {
        "POSTGRES_PASSWORD": {
            "description": "PostgreSQL superuser password",
            "generate": true
        },
        "REPLICATION_PASSWORD": {
            "description": "PostgreSQL replication user password",
            "generate": true
        },
        "HAPROXY_STATS_PASSWORD": {
            "description": "HAProxy statistics dashboard password",
            "generate": true
        }
    }
}